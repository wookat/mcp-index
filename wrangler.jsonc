{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcp-index",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "routes": [
    { "pattern": "mcp.zalize.com", "custom_domain": true }
  ],
  "rules": [
    { "type": "Data", "globs": ["**/*.png"], "fallthrough": true }
  ],
  "kv_namespaces": [
    { "binding": "METRICS", "id": "e7bd9f3b70774a06b54f9ced1026397f" }
  ],
  "unsafe": {
    "bindings": [
      { "name": "TRACK_RL", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
    ]
  },
  "observability": { "enabled": true }
}
